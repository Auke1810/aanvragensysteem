# Databasegegevens (MySQL of MariaDB). Lokaal in .env, op Hostinger in hPanel als omgevingsvariabelen.
# Zet hier nooit echte wachtwoorden in dit voorbeeldbestand. Het gaat mee naar GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Optioneel
# DB_SSL=true            # alleen als de databaseserver SSL eist
# TRUST_PROXY_HOPS=1     # aantal proxies voor de Node-app (Hostinger: 1). Zet op 0 als er geen proxy voor staat.
