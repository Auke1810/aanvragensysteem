# Hostinger (LiteSpeed/Apache) instellingen voor de statische Astro-site

Options -Indexes
ErrorDocument 404 /404.html

# Altijd https en zonder www
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://aanvragensysteem.nl%{REQUEST_URI} [L,R=301]
</IfModule>

# Compressie
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

# Caching: bestanden in /_astro/ hebben een hash in de naam en veranderen nooit
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|webp|avif|jpg|jpeg|png|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
</IfModule>
