---
interface Props {
  label: string;
  variant?: 'primary' | 'secondary' | 'dark';
  href?: string;
  arrow?: boolean;
  onDark?: boolean;
  full?: boolean;
  small?: boolean;
  type?: 'submit' | 'button';
  id?: string;
}
const { label, variant = 'primary', href, onDark = false, full = false, small = false, type = 'submit', id } = Astro.props;
const arrow = Astro.props.arrow ?? variant !== 'dark';
const cls = ['btn', `btn-${variant}`, onDark && 'on-dark', full && 'btn-full', small && 'btn-small'].filter(Boolean).join(' ');
const external = href?.startsWith('http');
---
{href ? (
  <a href={href} class={cls} id={id} {...(external ? { rel: 'noopener', target: '_blank' } : {})}>{label}{arrow && <span class="arr" aria-hidden="true">→</span>}</a>
) : (
  <button type={type} class={cls} id={id}>{label}{arrow && <span class="arr" aria-hidden="true">→</span>}</button>
)}
