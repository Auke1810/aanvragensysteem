---
interface Props { label?: string; href?: string }
const { label = 'Live op deze site', href } = Astro.props;
const style = 'display:inline-flex;align-items:center;gap:8px;padding:4px 10px 4px 8px;border-radius:999px;background:#e7f4ec;color:#17693f;font:700 13px/1.2 var(--font-sans);text-decoration:none;white-space:nowrap';
---
{href ? (
  <a href={href} class="h-ul" style={style}><span class="live-dot" aria-hidden="true"></span><span>{label}</span></a>
) : (
  <span style={style}><span class="live-dot" aria-hidden="true"></span><span>{label}</span></span>
)}
