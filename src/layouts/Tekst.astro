---
import Base from './Base.astro';
interface Props { title: string; description: string; bijgewerkt: string; intro?: string }
const { title, description, bijgewerkt, intro } = Astro.props;
---
<Base title={title} description={description} footerBorder>
<main id="hoofdinhoud" style="font-family:var(--font-sans);color:#4b5563;font-size:17px;line-height:1.65">
  <section style="background:#fff;padding:clamp(48px,8vw,96px) 20px clamp(56px,8vw,96px)">
    <div class="tekst" style="max-width:760px;margin:0 auto">
      <h1 style="margin:0;font:800 clamp(34px,5.4vw,52px)/1.06 var(--font-sans);letter-spacing:-0.02em;color:#16233d">{title}</h1>
      <p style="margin:12px 0 0;font-size:15px">Laatst bijgewerkt: {bijgewerkt}</p>
      {intro && <p style="margin:24px 0 0;font-size:19px;color:#16233d">{intro}</p>}
      <slot />
    </div>
  </section>
</main>
</Base>
<style is:global>
  .tekst h2{margin:40px 0 8px;font:700 clamp(21px,2.4vw,24px)/1.3 var(--font-sans);color:#16233d}
  .tekst p{margin:12px 0 0}
  .tekst ul{margin:12px 0 0;padding-left:22px}
  .tekst li{margin:6px 0}
  .tekst table{width:100%;border-collapse:collapse;margin:16px 0 0;font-size:16px}
  .tekst th,.tekst td{text-align:left;vertical-align:top;padding:10px 12px;border-top:1px solid var(--grey-200)}
  .tekst th{color:#16233d;font-weight:700}
</style>
