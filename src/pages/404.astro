---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
---
<Base title="Pagina niet gevonden" description="Deze pagina bestaat niet." noindex>
<main id="hoofdinhoud" style="font-family:var(--font-sans);color:#4b5563;font-size:17px;line-height:1.6">
  <section data-screen-label="01 404" style="background:#fff;padding:clamp(64px,12vw,140px) 20px">
    <div style="max-width:760px;margin:0 auto">
      <p style="margin:0 0 16px;font:800 15px/1 var(--font-sans);color:#c34209;font-variant-numeric:tabular-nums">404</p>
      <h1 style="margin:0;font:800 clamp(38px,6vw,60px)/1.04 var(--font-sans);letter-spacing:-0.02em;color:#16233d">Deze pagina bestaat niet.</h1>
      <p style="margin:20px 0 0;font-size:clamp(18px,2vw,21px)">Je aanvraag zou hier wel binnen 2 minuten zijn opgepakt.</p>
      <div style="margin-top:32px"><Btn variant="primary" href="/scan/" label="Vraag je gratis Aanvragen Scan aan" /></div>
      <ul style="list-style:none;margin:40px 0 0;padding:24px 0 0;border-top:1px solid var(--grey-200);display:flex;flex-wrap:wrap;gap:8px 24px">
        <li><a href="/" style="font-weight:700">Home</a></li>
        <li><a href="/aanvragensysteem/" style="font-weight:700">Het Aanvragensysteem</a></li>
        <li><a href="/prijs/" style="font-weight:700">Prijs</a></li>
        <li><a href="/vragen/" style="font-weight:700">Vragen</a></li>
      </ul>
    </div>
  </section>
</main>
</Base>
