---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import LiveLabel from '../components/LiveLabel.astro';
import RegioCheck from '../components/RegioCheck.astro';
import SamPhone from '../components/SamPhone.astro';
import { FP_LEFT } from '../config';
const stack = [
  ['Website, 10 pagina\'s, mobiel eerst', '€ 3.500'], ['Beheer 12 maanden', '€ 1.800'], ['6 dienst- en regiopagina\'s bij de start', '€ 1.200'],
  ['Google Bedrijfsprofiel', '€ 400'], ['Meting', '€ 450'], ['Conversiechecks, 4 per jaar', '€ 800'], ['WhatsApp-opvolging met AI', '€ 1.500'],
  ['Inbox en app, 12 maanden', '€ 600'], ['Offerte-opvolging', '€ 1.200'], ['Reviewautomatisering', '€ 400'], ['Onderhouds- en doorverwijsberichten', '€ 800'],
  ['Local SEO en AIEO, 12 maanden', '€ 3.600'], ['Content: 24 stukken plus Google-posts', '€ 2.400'], ['Twee reactivatiecampagnes', '€ 1.500'],
  ['Groeipartner', '€ 1.200'], ['Bonussen', '€ 1.590']
].map(([n, v]) => ({ n, v }));
---
<Base title="Het Aanvragensysteem: zes stappen tot vaste klant" description="De Aanvragenroute in zes stappen: wat erin zit, wat het kost en wat jij zelf doet. Eén vast maandbedrag en een garantie op resultaat." active="systeem" footerBorder>
<main id="hoofdinhoud" style="font-family:var(--font-sans);color:#4b5563;font-size:17px;line-height:1.6">

  <section data-screen-label="01 Hero" style="background:#16233d;padding:clamp(48px,8vw,96px) 20px clamp(40px,6vw,72px)">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 16px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#f7a57f">Het product</p>
      <h1 style="margin:0;font:800 clamp(34px,5.2vw,54px)/1.06 var(--font-sans);letter-spacing:-0.02em;color:#fff;max-width:22ch;text-wrap:balance">Het Aanvragensysteem: de complete route van eerste zoekopdracht tot vaste klant.</h1>
      <p style="margin:24px 0 0;font-size:clamp(17px,1.6vw,19px);color:#d4d7de;max-width:56ch">Ik bouw en beheer alle zes stappen. Jij belt alleen nog voorbereid terug.</p>
      <div style="margin-top:32px"><Btn variant="primary" href="/scan/" label="Vraag je gratis Aanvragen Scan aan" /></div>
      <p style="margin:clamp(40px,5vw,56px) 0 12px;font:700 12px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#d4d7de">De Aanvragenroute</p>
      <ol class="cols-step" aria-label="De Aanvragenroute in zes stappen" style="list-style:none;margin:0;padding:0;display:grid;gap:8px">
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">01</span>Gevonden</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">02</span>Vertrouwen</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">03</span>Aanvraag</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:11px 13px;border:2px solid #f16a2c;border-radius:8px;background:#1d2b47;color:#fff;font-weight:800;font-size:15px"><span style="color:#f7a57f;font-size:13px">04</span>Opvolging</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">05</span>Offerte</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">06</span>Vaste klant</li>
      </ol>
    </div>
  </section>
  <section aria-label="Feiten" style="background:#fff;border-bottom:1px solid var(--grey-200);padding:0 20px">
    <ul class="cols-fact" style="max-width:1120px;margin:0 auto;padding:20px 0;list-style:none;display:grid;gap:12px 32px">
      <li style="display:flex;gap:10px;align-items:baseline;font-weight:700;color:#16233d"><span aria-hidden="true" style="color:#c34209">01</span>Zes stappen, één systeem</li>
      <li style="display:flex;gap:10px;align-items:baseline;font-weight:700;color:#16233d"><span aria-hidden="true" style="color:#c34209">02</span>Elke aanvraag binnen 2 minuten antwoord</li>
      <li style="display:flex;gap:10px;align-items:baseline;font-weight:700;color:#16233d"><span aria-hidden="true" style="color:#c34209">03</span>Je oude offertes benaderd in week 1</li>
      <li style="display:flex;gap:10px;align-items:baseline;font-weight:700;color:#16233d"><span aria-hidden="true" style="color:#c34209">04</span>Jouw werk: ongeveer 3 uur</li>
    </ul>
  </section>

  <section data-screen-label="02 Probleem" style="background:#fff;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Het probleem</p>
      <h2 style="margin:0;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:22ch;text-wrap:balance">Je verliest geen werk op één plek. Je verliest het op zes.</h2>
      <ol class="cols-prob" aria-label="Waar werk weglekt" style="list-style:none;margin:48px 0 0;padding:0;display:grid;gap:28px 16px">
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">01</p><p style="margin:8px 0 0;display:flex;gap:8px;align-items:baseline;font-size:16px;line-height:1.5;color:#16233d"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Je wordt niet gevonden in je eigen regio.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">02</p><p style="margin:8px 0 0;display:flex;gap:8px;align-items:baseline;font-size:16px;line-height:1.5;color:#16233d"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Bezoekers haken af op een oude of trage site.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">03</p><p style="margin:8px 0 0;display:flex;gap:8px;align-items:baseline;font-size:16px;line-height:1.5;color:#16233d"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Contact opnemen is lastig.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">04</p><p style="margin:8px 0 0;display:flex;gap:8px;align-items:baseline;font-size:16px;line-height:1.5;color:#16233d"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Aanvragen en gemiste bellers blijven liggen.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">05</p><p style="margin:8px 0 0;display:flex;gap:8px;align-items:baseline;font-size:16px;line-height:1.5;color:#16233d"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Offertes gaan de deur uit, en niemand belt na.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">06</p><p style="margin:8px 0 0;display:flex;gap:8px;align-items:baseline;font-size:16px;line-height:1.5;color:#16233d"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Oud-klanten horen nooit meer iets.</p></li>
      </ol>
      <p style="margin:40px 0 0;font-size:clamp(18px,2vw,21px);line-height:1.5;color:#16233d;max-width:60ch">Een goede medewerker aan de telefoon helpt bij stap 4. <strong>Het Aanvragensysteem pakt alle zes stappen aan.</strong></p>
    </div>
  </section>

  <section data-screen-label="03 De Aanvragenroute" style="background:#f2f3f7;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">De Aanvragenroute</p>
      <h2 style="margin:0;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:24ch;text-wrap:balance">Per stap wat erin zit, en wat je terugziet in je maandrapport.</h2>
      <ol class="cols-card" style="list-style:none;margin:40px 0 0;padding:0;display:grid;gap:20px">
        <li style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:14px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap"><span style="font-weight:800;font-size:13px;color:#c34209">01</span><LiveLabel href="/zo-werkt-deze-site/#vakpaginas" /></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Gevonden worden</h3>
          <ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:4px;font-size:16px;flex:1"><li>6 dienst- en regiopagina's bij de start</li><li>Google Bedrijfsprofiel op orde</li><li>Local SEO en AIEO, 12 maanden</li><li>24 stukken content plus Google-posts</li></ul>
          <p style="margin:0;padding-top:12px;border-top:1px solid var(--grey-200);font-size:15px"><span style="display:block;font-size:13px;font-weight:700;color:#687185">Meetpunt in je maandrapport</span><span style="color:#16233d;font-weight:700">Bezoekers op je site</span></p>
        </li>
        <li style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:14px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap"><span style="font-weight:800;font-size:13px;color:#c34209">02</span><LiveLabel href="/zo-werkt-deze-site/" /></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Vertrouwen</h3>
          <ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:4px;font-size:16px;flex:1"><li>Website van 10 pagina's, mobiel eerst</li><li>Beheer, 12 maanden</li><li>Reviews en echte foto's</li><li>Conversiecheck, 4 keer per jaar</li></ul>
          <p style="margin:0;padding-top:12px;border-top:1px solid var(--grey-200);font-size:15px"><span style="display:block;font-size:13px;font-weight:700;color:#687185">Meetpunt in je maandrapport</span><span style="color:#16233d;font-weight:700">Deel van de bezoekers dat een aanvraag doet</span></p>
        </li>
        <li style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:14px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap"><span style="font-weight:800;font-size:13px;color:#c34209">03</span><LiveLabel href="/scan/" /></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Aanvraag</h3>
          <ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:4px;font-size:16px;flex:1"><li>Kort formulier</li><li>Bellen en WhatsApp op elk scherm</li><li>Meting van elke aanvraag</li></ul>
          <p style="margin:0;padding-top:12px;border-top:1px solid var(--grey-200);font-size:15px"><span style="display:block;font-size:13px;font-weight:700;color:#687185">Meetpunt in je maandrapport</span><span style="color:#16233d;font-weight:700">Aantal aanvragen</span></p>
        </li>
        <li style="background:#fff;border:1px solid #c34209;border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:14px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap"><span style="font-weight:800;font-size:13px;color:#c34209">04</span><LiveLabel href="/demo/" /></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Opvolging</h3>
          <ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:4px;font-size:16px;flex:1"><li>WhatsApp-opvolging met AI, binnen 2 minuten</li><li>Gemiste oproep krijgt een WhatsApp of sms</li><li>Inbox en app, 12 maanden</li></ul>
          <p style="margin:0;padding-top:12px;border-top:1px solid var(--grey-200);font-size:15px"><span style="display:block;font-size:13px;font-weight:700;color:#687185">Meetpunt in je maandrapport</span><span style="color:#16233d;font-weight:700">Reactietijd</span></p>
        </li>
        <li style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:14px">
          <div><span style="font-weight:800;font-size:13px;color:#c34209">05</span></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Van offerte naar opdracht</h3>
          <ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:4px;font-size:16px;flex:1"><li>Offerte-opvolging, bijvoorbeeld na 3, 7 en 14 dagen</li><li>Overzicht van alle open offertes</li></ul>
          <p style="margin:0;padding-top:12px;border-top:1px solid var(--grey-200);font-size:15px"><span style="display:block;font-size:13px;font-weight:700;color:#687185">Meetpunt in je maandrapport</span><span style="color:#16233d;font-weight:700">Offertes verstuurd en gewonnen</span></p>
        </li>
        <li style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:14px">
          <div><span style="font-weight:800;font-size:13px;color:#c34209">06</span></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Vaste klant</h3>
          <ul style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:4px;font-size:16px;flex:1"><li>Twee reactivatiecampagnes per jaar</li><li>Reviewverzoek na elke klus</li><li>Onderhouds- en doorverwijsberichten</li></ul>
          <p style="margin:0;padding-top:12px;border-top:1px solid var(--grey-200);font-size:15px"><span style="display:block;font-size:13px;font-weight:700;color:#687185">Meetpunt in je maandrapport</span><span style="color:#16233d;font-weight:700">Reacties op reactivatie en nieuwe reviews</span></p>
        </li>
      </ol>
      <div style="margin-top:20px;background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-wrap:wrap;gap:12px 32px;align-items:baseline;justify-content:space-between">
        <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Groeipartner</h3>
        <p style="margin:0;flex:1 1 420px">Elk kwartaal een gesprek, WhatsApp-support op werkdagen en een maandrapport met één meetpunt per stap.</p>
        <LiveLabel href="/resultaten/" />
      </div>
    </div>
  </section>

  <section data-screen-label="04 Stap 4 opvolging" style="background:#fff;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Stap 4 van 6</p>
      <h2 style="margin:0;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:22ch;text-wrap:balance">Sam pakt het op. Jij belt voorbereid terug.</h2>
      <ol style="list-style:none;margin:36px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(max(clamp(calc(25% - 24px),calc((880px - 100%) * 999),calc(50% - 12px)),clamp(0px,calc((520px - 100%) * 999),100%)),1fr));gap:20px">
        <li style="border-top:2px solid #16233d;padding-top:16px"><p style="margin:0 0 8px;font-weight:800;color:#c34209">Stap 1</p><p style="margin:0;color:#16233d">Er komt een aanvraag binnen, via je site of een gemiste oproep.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:16px"><p style="margin:0 0 8px;font-weight:800;color:#c34209">Stap 2</p><p style="margin:0;color:#16233d">Sam stuurt binnen 2 minuten een WhatsApp en zegt eerlijk dat hij een AI is.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:16px"><p style="margin:0 0 8px;font-weight:800;color:#c34209">Stap 3</p><p style="margin:0;color:#16233d">Sam stelt 2 à 3 vragen over de klus en legt een terugbelmoment vast.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:16px"><p style="margin:0 0 8px;font-weight:800;color:#c34209">Stap 4</p><p style="margin:0;color:#16233d">Jij krijgt een samenvatting in de app en belt voorbereid terug.</p></li>
      </ol>
      <h3 style="margin:56px 0 24px;font:700 22px/1.3 var(--font-sans);color:#16233d">Drie situaties</h3>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc(33.33% - 24px),calc((760px - 100%) * 999),100%),1fr));gap:32px 24px">
        <div><p style="margin:0 0 12px;font-weight:700;color:#16233d;text-align:center">Nieuwe aanvraag</p><SamPhone preset="dak" /></div>
        <div><p style="margin:0 0 12px;font-weight:700;color:#16233d;text-align:center">Gemiste oproep</p><SamPhone preset="gemist" /></div>
        <div><p style="margin:0 0 12px;font-weight:700;color:#16233d;text-align:center">Oude offerte</p><SamPhone preset="oud" /></div>
      </div>
      <div style="margin-top:64px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;align-items:baseline">
        <h3 style="margin:0;font:700 22px/1.3 var(--font-sans);color:#16233d">Wat jij ziet in de app</h3>
        <span style="padding:4px 10px;border-radius:999px;border:1px solid #9aa0ad;font-size:13px;font-weight:700;color:#4b5563">Voorbeeld met verzonnen gegevens</span>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px;margin-top:20px">
        <div style="border:1px solid var(--grey-200);border-radius:12px;overflow:hidden;background:#fff">
          <div style="padding:12px 16px;background:#f4f5f9;border-bottom:1px solid var(--grey-200);font-weight:700;color:#16233d;font-size:15px">Inbox</div>
          <ul style="list-style:none;margin:0;padding:0;font-size:15px">
            <li style="padding:12px 16px;border-bottom:1px solid var(--grey-200);display:flex;justify-content:space-between;gap:12px"><span><strong style="color:#16233d">Mevrouw De Vries</strong><span style="display:block;color:#4b5563">Daklekkage · Sam heeft gereageerd</span></span><span style="color:#687185;font-variant-numeric:tabular-nums">07:43</span></li>
            <li style="padding:12px 16px;border-bottom:1px solid var(--grey-200);display:flex;justify-content:space-between;gap:12px"><span><strong style="color:#16233d">Gemiste oproep</strong><span style="display:block;color:#4b5563">Sam stuurde een WhatsApp</span></span><span style="color:#687185;font-variant-numeric:tabular-nums">14:32</span></li>
            <li style="padding:12px 16px;display:flex;justify-content:space-between;gap:12px"><span><strong style="color:#16233d">P. Janssen</strong><span style="display:block;color:#4b5563">Dakisolatie · terugbelmoment gepland</span></span><span style="color:#687185">gisteren</span></li>
          </ul>
        </div>
        <div style="border:1px solid var(--grey-200);border-radius:12px;overflow:hidden;background:#fff">
          <div style="padding:12px 16px;background:#f4f5f9;border-bottom:1px solid var(--grey-200);font-weight:700;color:#16233d;font-size:15px">Samenvatting van Sam</div>
          <dl style="margin:0;padding:12px 16px;display:grid;grid-template-columns:auto 1fr;gap:8px 16px;font-size:15px">
