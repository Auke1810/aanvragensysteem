---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import { SITE } from '../config';
---
<Base title="Contact" description="Bel, app of mail Auke Jongbloed. WhatsApp is het snelst.">
<main id="hoofdinhoud" style="font-family:var(--font-sans);color:#4b5563;font-size:17px;line-height:1.6">
  <section data-screen-label="01 Contact" style="background:#fff;padding:clamp(48px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 16px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Contact</p>
      <h1 style="margin:0;font:800 clamp(38px,6vw,60px)/1.04 var(--font-sans);letter-spacing:-0.02em;color:#16233d">Bel, app of mail.</h1>
      <p style="margin:20px 0 0;font-size:clamp(17px,1.6vw,19px);max-width:56ch">Er is geen contactformulier. Wil je weten wat er bij jou blijft liggen? Dan is <a href="/scan/" style="font-weight:700">de scan</a> het formulier.</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc(33.33% - 24px),calc((760px - 100%) * 999),100%),1fr));gap:20px;margin-top:40px">
        <div style="border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:10px">
          <h2 style="margin:0;font:700 19px/1.3 var(--font-sans);color:#16233d">WhatsApp</h2>
          <p style="margin:0">Het snelst. Sam reageert direct, ik daarna zelf.</p>
          <div style="margin-top:auto"><Btn variant="primary" href={SITE.whatsapp} label="Stuur een WhatsApp" /></div>
        </div>
        <div style="border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:10px">
          <h2 style="margin:0;font:700 19px/1.3 var(--font-sans);color:#16233d">Telefoon</h2>
          <a href={SITE.phoneHref} style="font:800 22px/1.2 var(--font-sans);color:#16233d;font-variant-numeric:tabular-nums">{SITE.phoneDisplay}</a>
          <p style="margin:0;font-size:15px">Mis ik je? Dan krijg je binnen 2 minuten een bericht.</p>
        </div>
        <div style="border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:10px">
          <h2 style="margin:0;font:700 19px/1.3 var(--font-sans);color:#16233d">E-mail</h2>
          <a href={`mailto:${SITE.email}`} style="font-weight:700;font-size:18px">{SITE.email}</a>
          <p style="margin:0;font-size:15px">Antwoord binnen 1 werkdag.</p>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc(33.33% - 24px),calc((760px - 100%) * 999),100%),1fr));gap:20px;margin-top:20px">
        <div style="background:#f4f5f9;border-radius:12px;padding:24px">
          <h2 style="margin:0 0 8px;font:700 17px/1.3 var(--font-sans);color:#16233d">Gemiddelde reactietijd</h2>
          <p style="margin:0">Meting loopt sinds {SITE.meetingSinds}. <a href="/resultaten/">Zie resultaten</a>.</p>
        </div>
        <div style="background:#f4f5f9;border-radius:12px;padding:24px">
          <h2 style="margin:0 0 8px;font:700 17px/1.3 var(--font-sans);color:#16233d">Werkdagen en tijden</h2>
          <p style="margin:0">Maandag tot en met vrijdag, [tijden nog invullen]. Nederlandse tijd.</p>
        </div>
        <div style="background:#f4f5f9;border-radius:12px;padding:24px">
          <h2 style="margin:0 0 8px;font:700 17px/1.3 var(--font-sans);color:#16233d">Bedrijfsgegevens</h2>
          <p style="margin:0">Auke Jongbloed<br>Franse onderneming, [adres nog invullen]<br>SIRET [nog invullen]</p>
        </div>
      </div>
    </div>
  </section>
</main>
</Base>
