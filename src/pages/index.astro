---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
import LiveLabel from '../components/LiveLabel.astro';
import RegioCheck from '../components/RegioCheck.astro';
import Rekensom from '../components/Rekensom.astro';
import SamPhone from '../components/SamPhone.astro';
import { FP_LEFT } from '../config';
import { Image } from 'astro:assets';
import auke from '../assets/auke.webp';
---
<Base title="Het Aanvragensysteem voor vakbedrijven: meer opdrachten uit je eigen regio" description="Ik bouw en beheer je complete aanvragensysteem: gevonden worden, een site die aanvragen oplevert, opvolging binnen 2 minuten, offertes die worden opgevolgd en oud-klanten die terugkomen." footerBorder>
<main id="hoofdinhoud" style="font-family:var(--font-sans);color:#4b5563;font-size:17px;line-height:1.6">

  <section data-screen-label="01 Hero" style="background:#16233d;padding:clamp(40px,7vw,88px) 20px clamp(40px,6vw,72px)">
    <div style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:48px;align-items:center">
      <div>
        <p style="margin:0 0 16px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#f7a57f">Voor vakbedrijven die met offertes werken</p>
        <h1 style="margin:0;font:800 clamp(34px,5.2vw,54px)/1.06 var(--font-sans);letter-spacing:-0.02em;color:#fff;text-wrap:balance">Meer opdrachten uit je eigen regio. Van eerste zoekopdracht tot vaste klant.</h1>
        <p style="margin:24px 0 0;font-size:clamp(17px,1.6vw,19px);line-height:1.6;color:#d4d7de;max-width:58ch">Ik bouw en beheer je complete aanvragensysteem: gevonden worden, een site die bezoekers omzet in aanvragen, opvolging binnen 2 minuten, offertes die worden opgevolgd en oud-klanten die terugkomen. Eén vast maandbedrag, een garantie op resultaat en één bedrijf per vak per regio.</p>
        <div style="display:flex;flex-wrap:wrap;gap:12px;margin-top:32px">
          <Btn variant="primary" href="/scan/" label="Vraag je gratis Aanvragen Scan aan" />
          <Btn variant="secondary" onDark arrow={false} href="/demo/" label="Speel zelf de klant" />
        </div>
        <p style="margin:20px 0 0;font-size:15px;line-height:1.6;color:#d4d7de;max-width:56ch">Voor vakbedrijven met opdrachten vanaf ongeveer € 2.500. Nu actief voor dakdekkers. <a href="/voor-wie/" style="color:#fff;font-weight:700;text-decoration:underline">Voor wie is dit?</a></p>
      </div>
      <div style="display:flex;flex-direction:column;align-items:center;gap:16px">
        <LiveLabel href="/zo-werkt-deze-site/" />
        <div style="width:100%;max-width:340px;background:#fff;border-radius:16px;padding:16px 10px 12px">
          <SamPhone preset="home" />
        </div>
      </div>
    </div>
    <div style="max-width:1120px;margin:clamp(40px,5vw,56px) auto 0">
      <p style="margin:0 0 12px;font:700 12px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#d4d7de">De Aanvragenroute</p>
      <ol class="cols-step" aria-label="De Aanvragenroute in zes stappen" style="list-style:none;margin:0;padding:0;display:grid;gap:8px">
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">01</span>Gevonden</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">02</span>Vertrouwen</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">03</span>Aanvraag</li>
        <li aria-current="step" style="display:flex;gap:10px;align-items:baseline;padding:11px 13px;border:2px solid #f16a2c;border-radius:8px;background:#1d2b47;color:#fff;font-weight:800;font-size:15px"><span style="color:#f7a57f;font-size:13px">04</span>Opvolging</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">05</span>Offerte</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">06</span>Vaste klant</li>
      </ol>
      <p style="margin:10px 0 0;font-size:14px;color:#d4d7de">Stap 4 zie je hierboven: Sam antwoordt binnen 2 minuten.</p>
    </div>
  </section>

  <section data-screen-label="02 Feitenbalk" aria-label="Feiten" style="background:#fff;border-bottom:1px solid var(--grey-200);padding:0 20px">
    <ul class="cols-fact" style="max-width:1120px;margin:0 auto;padding:20px 0;list-style:none;display:grid;gap:12px 32px">
      <li style="display:flex;gap:10px;align-items:baseline;font-weight:700;color:#16233d"><span aria-hidden="true" style="color:#c34209">01</span>Zes stappen, één systeem</li>
      <li style="display:flex;gap:10px;align-items:baseline;font-weight:700;color:#16233d"><span aria-hidden="true" style="color:#c34209">02</span>Elke aanvraag binnen 2 minuten antwoord</li>
      <li style="display:flex;gap:10px;align-items:baseline;font-weight:700;color:#16233d"><span aria-hidden="true" style="color:#c34209">03</span>Je oude offertes benaderd in week 1</li>
      <li style="display:flex;gap:10px;align-items:baseline;font-weight:700;color:#16233d"><span aria-hidden="true" style="color:#c34209">04</span>Jouw werk: ongeveer 3 uur</li>
    </ul>
  </section>

  <section data-screen-label="03 Probleem" style="background:#fff;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Het probleem</p>
      <h2 style="margin:0;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:22ch;text-wrap:balance">Je verliest geen werk op één plek. Je verliest het op zes.</h2>
      <ol class="cols-prob" aria-label="Waar werk weglekt" style="list-style:none;margin:48px 0 0;padding:0;display:grid;gap:28px 16px">
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">01</p><p style="margin:2px 0 0;font:700 18px/1.3 var(--font-sans);color:#16233d">Gevonden worden</p><p style="margin:10px 0 0;display:flex;gap:8px;align-items:baseline;font-size:15px;line-height:1.5"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Niet zichtbaar in je regio</p></li>
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">02</p><p style="margin:2px 0 0;font:700 18px/1.3 var(--font-sans);color:#16233d">Vertrouwen</p><p style="margin:10px 0 0;display:flex;gap:8px;align-items:baseline;font-size:15px;line-height:1.5"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Bezoekers haken af op een oude site</p></li>
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">03</p><p style="margin:2px 0 0;font:700 18px/1.3 var(--font-sans);color:#16233d">Aanvraag</p><p style="margin:10px 0 0;display:flex;gap:8px;align-items:baseline;font-size:15px;line-height:1.5"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Contact opnemen is lastig</p></li>
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">04</p><p style="margin:2px 0 0;font:700 18px/1.3 var(--font-sans);color:#16233d">Opvolging</p><p style="margin:10px 0 0;display:flex;gap:8px;align-items:baseline;font-size:15px;line-height:1.5"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Geen antwoord 's avonds of bij drukte</p></li>
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">05</p><p style="margin:2px 0 0;font:700 18px/1.3 var(--font-sans);color:#16233d">Offerte</p><p style="margin:10px 0 0;display:flex;gap:8px;align-items:baseline;font-size:15px;line-height:1.5"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Verstuurd, niemand belt na</p></li>
        <li style="border-top:2px solid #16233d;padding-top:14px;position:relative"><span aria-hidden="true" style="position:absolute;top:-7px;left:0;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:13px;color:#c34209">06</p><p style="margin:2px 0 0;font:700 18px/1.3 var(--font-sans);color:#16233d">Vaste klant</p><p style="margin:10px 0 0;display:flex;gap:8px;align-items:baseline;font-size:15px;line-height:1.5"><span aria-hidden="true" style="flex:none;width:8px;height:8px;border-radius:999px;border:2px solid #c34209;transform:translateY(-1px)"></span>Oud-klanten horen nooit meer iets</p></li>
      </ol>
      <p style="margin:40px 0 0;font-size:clamp(18px,2vw,21px);line-height:1.5;color:#16233d;max-width:60ch">Een goede medewerker aan de telefoon helpt bij stap 4. <strong>Het Aanvragensysteem pakt alle zes stappen aan.</strong></p>
    </div>
  </section>

  <section data-screen-label="04 De Aanvragenroute" style="background:#f2f3f7;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">De Aanvragenroute</p>
      <h2 style="margin:0;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:24ch;text-wrap:balance">Eén systeem. Zes stappen. Jij belt alleen nog voorbereid terug.</h2>
      <ol class="cols-card" style="list-style:none;margin:40px 0 0;padding:0;display:grid;gap:20px">
        <li style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap"><span style="font-weight:800;font-size:13px;color:#c34209">01</span><LiveLabel href="/zo-werkt-deze-site/#vakpaginas" /></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Gevonden worden</h3>
          <div><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Waar het lekt</p><p style="margin:2px 0 0;font-size:16px">Niet zichtbaar in je regio, op Google en in AI-antwoorden.</p></div>
          <div><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Wat het systeem doet</p><p style="margin:2px 0 0;font-size:16px;color:#16233d">Dienst- en regiopagina's, een sterk Google-profiel en 2 stukken content per maand.</p></div>
        </li>
        <li style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap"><span style="font-weight:800;font-size:13px;color:#c34209">02</span><LiveLabel href="/zo-werkt-deze-site/" /></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Vertrouwen</h3>
          <div><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Waar het lekt</p><p style="margin:2px 0 0;font-size:16px">Bezoekers haken af op een oude of trage site.</p></div>
          <div><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Wat het systeem doet</p><p style="margin:2px 0 0;font-size:16px;color:#16233d">Een snelle site gericht op aanvragen, met reviews en echte foto's.</p></div>
        </li>
        <li style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap"><span style="font-weight:800;font-size:13px;color:#c34209">03</span><LiveLabel href="/scan/" /></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Aanvraag</h3>
          <div><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Waar het lekt</p><p style="margin:2px 0 0;font-size:16px">Contact opnemen is lastig.</p></div>
          <div><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Wat het systeem doet</p><p style="margin:2px 0 0;font-size:16px;color:#16233d">Een kort formulier, bellen en WhatsApp op elk scherm.</p></div>
        </li>
        <li style="background:#fff;border:1px solid #c34209;border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap"><span style="font-weight:800;font-size:13px;color:#c34209">04</span><LiveLabel href="/demo/" /></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Opvolging</h3>
          <div><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Waar het lekt</p><p style="margin:2px 0 0;font-size:16px">'s Avonds, in het weekend, bij drukte.</p></div>
          <div><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Wat het systeem doet</p><p style="margin:2px 0 0;font-size:16px;color:#16233d">Sam reageert binnen 2 minuten, stelt 2 à 3 vragen en plant een terugbelmoment.</p></div>
        </li>
        <li style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap"><span style="font-weight:800;font-size:13px;color:#c34209">05</span></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Van offerte naar opdracht</h3>
          <div><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Waar het lekt</p><p style="margin:2px 0 0;font-size:16px">Offerte verstuurd, niemand belt na.</p></div>
          <div style="border:1px dashed #a5a9b8;border-radius:8px;padding:10px 12px"><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Wat het systeem doet · werkwijze nog te bevestigen</p><p style="margin:2px 0 0;font-size:16px;color:#16233d">Jij meldt een verstuurde offerte met één handeling aan. Daarna volgt het systeem hem op met persoonlijke berichten.</p></div>
        </li>
        <li style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:12px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:8px;flex-wrap:wrap"><span style="font-weight:800;font-size:13px;color:#c34209">06</span></div>
          <h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Vaste klant</h3>
          <div><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Waar het lekt</p><p style="margin:2px 0 0;font-size:16px">Oud-klanten horen nooit meer iets.</p></div>
          <div><p style="margin:0;font-size:13px;font-weight:700;color:#687185">Wat het systeem doet</p><p style="margin:2px 0 0;font-size:16px;color:#16233d">Twee keer per jaar oud-klanten benaderen, onderhoud en uitbreiding aanbieden, reviews en doorverwijzingen vragen.</p></div>
        </li>
      </ol>
      <p style="margin:36px 0 0;font-size:clamp(18px,2vw,20px);line-height:1.5;color:#16233d;max-width:62ch"><strong>Jij doet:</strong> één intake van 45 minuten, foto's aanleveren en teksten goedkeuren. Samen ongeveer 3 uur. De rest doe ik.</p>
      <div style="margin-top:24px"><Btn variant="primary" href="/scan/" label="Vraag je gratis Aanvragen Scan aan" /></div>
    </div>
  </section>

  <section data-screen-label="05 Opvolging" style="background:#fff;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Stap 4 van 6</p>
      <h2 style="margin:0;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:22ch;text-wrap:balance;font-variant-numeric:tabular-nums">Een aanvraag om 21.04 uur. Om 21.05 heeft hij antwoord.</h2>
      <ol style="list-style:none;margin:40px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(max(clamp(calc(25% - 24px),calc((880px - 100%) * 999),calc(50% - 12px)),clamp(0px,calc((520px - 100%) * 999),100%)),1fr));gap:20px">
        <li style="border-top:2px solid #16233d;padding-top:16px"><p style="margin:0 0 8px;font-weight:800;color:#c34209;font-variant-numeric:tabular-nums">Stap 1 · 21.04</p><p style="margin:0;color:#16233d">Er komt een aanvraag binnen, via je site of een gemiste oproep.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:16px"><p style="margin:0 0 8px;font-weight:800;color:#c34209;font-variant-numeric:tabular-nums">Stap 2 · 21.05</p><p style="margin:0;color:#16233d">Sam, je digitale assistent, stuurt binnen 2 minuten een WhatsApp en zegt eerlijk dat hij een AI is.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:16px"><p style="margin:0 0 8px;font-weight:800;color:#c34209">Stap 3</p><p style="margin:0;color:#16233d">Sam stelt 2 à 3 vragen over de klus en legt een terugbelmoment vast.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:16px"><p style="margin:0 0 8px;font-weight:800;color:#c34209">Stap 4</p><p style="margin:0;color:#16233d">Jij krijgt een samenvatting in de app en belt voorbereid terug.</p></li>
      </ol>
      <div style="margin-top:32px"><Btn variant="secondary" arrow={false} href="/demo/" label="Speel zelf de klant" /></div>
    </div>
  </section>

  <section data-screen-label="06 Offerte en vaste klant" style="background:#f2f3f7;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Stap 5 en 6: van offerte naar vaste klant</p>
      <h2 style="margin:0;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:24ch;text-wrap:balance">Er ligt vaak meer werk bij klanten die je al hebt dan je denkt.</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px;margin-top:40px">
        <div style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:28px">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:12px;flex-wrap:wrap"><h3 style="margin:0;font:700 21px/1.3 var(--font-sans);color:#16233d">Offerte-opvolging</h3><span style="padding:3px 10px;border:1px solid var(--grey-200);border-radius:999px;font-size:13px;font-weight:700;color:#4b5563">Voorbeeld</span></div>
          <ol style="list-style:none;margin:24px 0 0;padding:0 0 0 20px;border-left:2px solid #16233d;display:flex;flex-direction:column;gap:18px">
            <li style="position:relative"><span aria-hidden="true" style="position:absolute;left:-27px;top:6px;width:12px;height:12px;border-radius:999px;background:#16233d"></span><p style="margin:0;font-weight:800;font-size:14px;color:#c34209">Dag 0</p><p style="margin:2px 0 0;color:#16233d">Offerte verstuurd</p></li>
