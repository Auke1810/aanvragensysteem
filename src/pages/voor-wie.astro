---
import Base from '../layouts/Base.astro';
import Btn from '../components/Btn.astro';
---
<Base title="Voor wie is Het Aanvragensysteem?" description="Voor vakbedrijven met 3 tot 25 mensen en opdrachten vanaf ongeveer € 2.500. Niet je vak is leidend, maar hoe je werk binnenkomt. Bekijk de vijf criteria." active="voorwie" footerBorder>
<main id="hoofdinhoud" style="font-family:var(--font-sans);color:#4b5563;font-size:17px;line-height:1.6">
  <section data-screen-label="01 Hero" style="background:#fff;padding:clamp(48px,8vw,96px) 20px clamp(32px,5vw,56px)">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 16px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Voor wie</p>
      <h1 style="margin:0;font:800 clamp(34px,5.2vw,54px)/1.06 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:20ch;text-wrap:balance">Voor wie is Het Aanvragensysteem?</h1>
      <p style="margin:24px 0 0;font-size:clamp(17px,1.6vw,19px);max-width:58ch">Voor vakbedrijven waar één extra opdracht het verschil maakt. Het gaat niet om je vak, maar om hoe je werk binnenkomt.</p>
    </div>
  </section>

  <section data-screen-label="02 Criteria" style="background:#fff;padding:0 20px clamp(56px,8vw,96px)">
    <div style="max-width:1120px;margin:0 auto">
      <h2 style="margin:0 0 8px;font:800 clamp(24px,3.2vw,30px)/1.2 var(--font-sans);color:#16233d">De vijf criteria</h2>
      <p style="margin:0 0 24px">Herken je jezelf in alle vijf? Dan past het waarschijnlijk.</p>
      <ol style="list-style:none;margin:0;padding:0;border-top:1px solid var(--grey-200)">
        <li style="display:grid;grid-template-columns:56px 1fr;gap:16px;padding:22px 0;border-bottom:1px solid var(--grey-200);align-items:baseline"><span style="font:800 22px/1 var(--font-sans);color:#c34209">01</span><span style="font:700 clamp(18px,2vw,21px)/1.4 var(--font-sans);color:#16233d">Opdrachten vanaf ongeveer € 2.500</span></li>
        <li style="display:grid;grid-template-columns:56px 1fr;gap:16px;padding:22px 0;border-bottom:1px solid var(--grey-200);align-items:baseline"><span style="font:800 22px/1 var(--font-sans);color:#c34209">02</span><span style="font:700 clamp(18px,2vw,21px)/1.4 var(--font-sans);color:#16233d">Klanten die terugkomen of je doorverwijzen: onderhoud, uitbreiding, een volgende klus</span></li>
        <li style="display:grid;grid-template-columns:56px 1fr;gap:16px;padding:22px 0;border-bottom:1px solid var(--grey-200);align-items:baseline"><span style="font:800 22px/1 var(--font-sans);color:#c34209">03</span><span style="font:700 clamp(18px,2vw,21px)/1.4 var(--font-sans);color:#16233d">Klanten vragen bij meerdere bedrijven een offerte aan</span></li>
        <li style="display:grid;grid-template-columns:56px 1fr;gap:16px;padding:22px 0;border-bottom:1px solid var(--grey-200);align-items:baseline"><span style="font:800 22px/1 var(--font-sans);color:#c34209">04</span><span style="font:700 clamp(18px,2vw,21px)/1.4 var(--font-sans);color:#16233d">Je werkt in een eigen regio</span></li>
        <li style="display:grid;grid-template-columns:56px 1fr;gap:16px;padding:22px 0;border-bottom:1px solid var(--grey-200);align-items:baseline"><span style="font:800 22px/1 var(--font-sans);color:#c34209">05</span><span style="font:700 clamp(18px,2vw,21px)/1.4 var(--font-sans);color:#16233d">3 tot 25 mensen, en ruimte voor meer werk</span></li>
      </ol>
    </div>
  </section>

  <section data-screen-label="03 Actieve vakken" style="background:#f2f3f7;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Nu actief voor</p>
      <h2 style="margin:0 0 28px;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d">Eén vak tegelijk.</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px">
        <a class="h-card" href="/voor/dakdekkers/" style="display:flex;flex-direction:column;gap:10px;background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:28px;text-decoration:none;color:#4b5563">
          <span style="display:flex;justify-content:space-between;gap:12px;align-items:center;flex-wrap:wrap"><span style="font:700 22px/1.3 var(--font-sans);color:#16233d">Dakdekkers</span><span style="padding:4px 10px;border-radius:999px;background:#16233d;color:#fff;font-size:13px;font-weight:700">Nu actief</span></span>
          <span>Dakrenovatie, dakisolatie en reparaties. Spoed na een storm maakt snelle opvolging extra waardevol.</span>
          <span style="color:#c34209;font-weight:700">Bekijk de pagina voor dakdekkers →</span>
        </a>
        <div style="display:flex;flex-direction:column;gap:10px;background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:28px">
          <span style="font:700 22px/1.3 var(--font-sans);color:#16233d">Staat je vak er niet bij?</span>
          <span>Voldoe je aan de criteria, vraag dan de scan aan. Dan kijken we samen of het past.</span>
          <a href="/regiocheck/" style="font-weight:700">Check of je vak en regio vrij zijn →</a>
        </div>
      </div>
    </div>
  </section>

  <section data-screen-label="04 Slot" style="background:#16233d;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:760px;margin:0 auto;text-align:center;display:flex;flex-direction:column;align-items:center">
      <h2 style="margin:0;font:800 clamp(30px,4.6vw,46px)/1.1 var(--font-sans);letter-spacing:-0.02em;color:#fff">Herken je jezelf?</h2>
      <p style="margin:20px 0 0;color:#d4d7de;font-size:18px">Vraag de gratis Aanvragen Scan aan. Binnen 2 werkdagen krijg je een persoonlijke video met wat er bij jou blijft liggen.</p>
      <div style="margin-top:32px"><Btn variant="primary" href="/scan/" label="Vraag je gratis Aanvragen Scan aan" /></div>
      <p style="margin:16px 0 0;color:#d4d7de;font-size:15px">Je krijgt binnen 2 minuten een WhatsApp van Sam. Dat is meteen je eerste demo.</p>
    </div>
  </section>
</main>
</Base>
