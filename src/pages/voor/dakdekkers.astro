---
import Base from '../../layouts/Base.astro';
import Btn from '../../components/Btn.astro';
import RegioCheck from '../../components/RegioCheck.astro';
import Rekensom from '../../components/Rekensom.astro';
import SamPhone from '../../components/SamPhone.astro';
import { FP_LEFT } from '../../config';
---
<Base title="Het Aanvragensysteem voor dakdekkers" description="Meer aanvragen voor dakrenovatie, dakisolatie en reparaties uit je eigen regio. Elke aanvraag binnen 2 minuten opgepakt, ook als jij op een dak staat." active="voorwie" footerBorder>
<main id="hoofdinhoud" style="font-family:var(--font-sans);color:#4b5563;font-size:17px;line-height:1.6">
  <nav aria-label="Kruimelpad" style="background:#16233d;padding:16px 20px 0"><ol style="max-width:1120px;margin:0 auto;padding:0;list-style:none;display:flex;gap:8px;font-size:14px;color:#d4d7de"><li><a href="/voor-wie/" style="color:#fff">Voor wie</a></li><li aria-hidden="true">/</li><li aria-current="page">Dakdekkers</li></ol></nav>
  <section data-screen-label="01 Hero" style="background:#16233d;padding:clamp(32px,6vw,72px) 20px clamp(48px,7vw,88px)">
    <div style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,440px),1fr));gap:48px;align-items:center">
      <div>
        <p style="margin:0 0 16px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#f7a57f">Nu actief · dakdekkers</p>
        <h1 style="margin:0;font:800 clamp(34px,5.2vw,54px)/1.06 var(--font-sans);letter-spacing:-0.02em;color:#fff;max-width:16ch;text-wrap:balance">Het Aanvragensysteem voor dakdekkers</h1>
        <p style="margin:24px 0 0;font-size:clamp(17px,1.6vw,19px);color:#d4d7de;max-width:56ch">Meer aanvragen voor dakrenovatie, dakisolatie en reparaties uit je eigen regio. Elke aanvraag binnen 2 minuten opgepakt, ook als jij op een dak staat.</p>
        <div style="margin-top:32px"><Btn variant="primary" href="/scan/?vak=Dakdekkers" label="Vraag je gratis Aanvragen Scan aan" /></div>
      </div>
      <div style="display:flex;justify-content:center"><div style="width:100%;max-width:340px;background:#fff;border-radius:16px;padding:16px 10px 12px"><SamPhone preset="dak" /></div></div>
    </div>
    <div style="max-width:1120px;margin:clamp(40px,5vw,56px) auto 0">
      <p style="margin:0 0 12px;font:700 12px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#d4d7de">De Aanvragenroute</p>
      <ol class="cols-step" aria-label="De Aanvragenroute in zes stappen" style="list-style:none;margin:0;padding:0;display:grid;gap:8px">
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">01</span>Gevonden</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">02</span>Vertrouwen</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">03</span>Aanvraag</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:11px 13px;border:2px solid #f16a2c;border-radius:8px;background:#1d2b47;color:#fff;font-weight:800;font-size:15px"><span style="color:#f7a57f;font-size:13px">04</span>Opvolging</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">05</span>Offerte</li>
        <li style="display:flex;gap:10px;align-items:baseline;padding:12px 14px;border:1px solid rgba(255,255,255,.14);border-radius:8px;background:#1d2b47;color:#fff;font-weight:700;font-size:15px"><span style="color:#f7a57f;font-size:13px">06</span>Vaste klant</li>
      </ol>
    </div>
  </section>
  <section aria-label="Feiten" style="background:#fff;border-bottom:1px solid var(--grey-200);padding:0 20px">
    <ul style="max-width:1120px;margin:0 auto;padding:20px 0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc(33.33% - 24px),calc((760px - 100%) * 999),100%),1fr));gap:12px 32px">
      <li style="display:flex;gap:10px;font-weight:700;color:#16233d"><span aria-hidden="true" style="color:#c34209">01</span>Live in 4 weken</li>
      <li style="display:flex;gap:10px;font-weight:700;color:#16233d"><span aria-hidden="true" style="color:#c34209">02</span>Elke aanvraag binnen 2 minuten antwoord</li>
      <li style="display:flex;gap:10px;font-weight:700;color:#16233d"><span aria-hidden="true" style="color:#c34209">03</span>Jouw werk: ongeveer 3 uur</li>
    </ul>
  </section>

  <section data-screen-label="02 Waarom nu" style="background:#fff;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:800px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Waarom nu</p>
      <p style="margin:0;font:700 clamp(21px,2.6vw,28px)/1.4 var(--font-sans);color:#16233d">Na een storm of een natte week belt iedereen tegelijk. Wie dan als eerste reageert, krijgt de klus. En via een klusplatform deel je een aanvraag vaak met andere dakdekkers. Aanvragen via je eigen site zijn alleen van jou.</p>
    </div>
  </section>

  <section data-screen-label="03 Herkenbaar" style="background:#f2f3f7;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Herkenbaar?</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc(33.33% - 24px),calc((760px - 100%) * 999),100%),1fr));gap:20px">
        <div style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px"><p style="margin:0;font-size:19px;line-height:1.45;color:#16233d;font-weight:600">Je staat op een dak als de telefoon gaat.</p></div>
        <div style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px"><p style="margin:0;font-size:19px;line-height:1.45;color:#16233d;font-weight:600">Na een storm krijg je in één dag meer telefoontjes dan je kunt terugbellen.</p></div>
        <div style="background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px"><p style="margin:0;font-size:19px;line-height:1.45;color:#16233d;font-weight:600">Offertes voor een nieuw dak blijven maanden liggen. De klant twijfelt, en niemand belt na.</p></div>
      </div>
    </div>
  </section>

  <section data-screen-label="04 Wat Sam vraagt" style="background:#fff;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Wat Sam vraagt</p>
      <h2 style="margin:0;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:24ch">Drie vragen. Dan weet jij waar het om gaat.</h2>
      <ol style="list-style:none;margin:32px 0 0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc(33.33% - 24px),calc((760px - 100%) * 999),100%),1fr));gap:20px">
        <li style="border-top:2px solid #16233d;padding-top:16px"><p style="margin:0 0 8px;font-weight:800;color:#c34209">Vraag 1</p><p style="margin:0;color:#16233d">Gaat het om een lekkage, een reparatie, een renovatie of isolatie?</p></li>
        <li style="border-top:2px solid #16233d;padding-top:16px"><p style="margin:0 0 8px;font-weight:800;color:#c34209">Vraag 2</p><p style="margin:0;color:#16233d">Wat voor dak is het, plat of schuin, en ongeveer hoe groot? Een foto sturen mag ook.</p></li>
        <li style="border-top:2px solid #16233d;padding-top:16px"><p style="margin:0 0 8px;font-weight:800;color:#c34209">Vraag 3</p><p style="margin:0;color:#16233d">Is het spoed, of mag het binnen een paar weken?</p></li>
      </ol>
      <p style="margin:28px 0 0;color:#16233d">Daarna plant Sam een terugbelmoment. <strong>Spoed staat bovenaan in de app.</strong></p>
    </div>
  </section>

  <section data-screen-label="05 Voorbeeldberichten" style="background:#f2f3f7;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Stap 5 en 6</p>
      <h2 style="margin:0;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:24ch;text-wrap:balance">Voorbeeldberichten: oud-klant, offerte en onderhoud</h2>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc(33.33% - 24px),calc((760px - 100%) * 999),100%),1fr));gap:20px;margin-top:32px">
        <figure style="margin:0;background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:12px">
          <figcaption style="font-weight:800;font-size:13px;color:#c34209">Oud-klant</figcaption>
          <blockquote style="margin:0;font-size:17px;line-height:1.55;color:#16233d">Hoi &#123;voornaam&#125;, dit is een automatisch bericht namens &#123;bedrijf&#125;. Je vroeg vorig jaar een offerte aan voor je dak. Voor de winter is een goed moment om het te laten nakijken. Zal &#123;eigenaar&#125; je even bellen? Liever geen berichten meer? Stuur STOP.</blockquote>
        </figure>
        <figure style="margin:0;background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:12px">
          <figcaption style="font-weight:800;font-size:13px;color:#c34209">Offerte-opvolging, na 3 dagen</figcaption>
          <blockquote style="margin:0;font-size:17px;line-height:1.55;color:#16233d">Hoi &#123;voornaam&#125;, dit is een automatisch bericht namens &#123;bedrijf&#125;. Je kreeg deze week de offerte voor je dak. Zijn er nog vragen, of zal &#123;eigenaar&#125; je even bellen? Liever geen berichten meer? Stuur STOP.</blockquote>
        </figure>
        <figure style="margin:0;background:#fff;border:1px solid var(--grey-200);border-radius:12px;padding:24px;display:flex;flex-direction:column;gap:12px">
          <figcaption style="font-weight:800;font-size:13px;color:#c34209">Onderhoud, een jaar na de klus</figcaption>
          <blockquote style="margin:0;font-size:17px;line-height:1.55;color:#16233d">Hoi &#123;voornaam&#125;, dit is een automatisch bericht namens &#123;bedrijf&#125;. Vorig jaar hebben we je dak gedaan. Voor de winter controleren we graag je dakgoten en afvoeren. Zal &#123;eigenaar&#125; een moment voorstellen? Liever geen berichten meer? Stuur STOP.</blockquote>
        </figure>
      </div>
      <p style="margin:16px 0 0;font-size:15px">Voorbeeldberichten. Tussen accolades vullen we jouw gegevens in.</p>
    </div>
  </section>

  <section data-screen-label="06 Pagina's" style="background:#fff;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Pagina's die ik voor je maak</p>
      <h2 style="margin:0 0 28px;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:24ch">Gevonden worden op wat mensen echt zoeken.</h2>
      <ul style="list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(auto-fit,minmax(clamp(calc(33.33% - 24px),calc((760px - 100%) * 999),100%),1fr));gap:20px">
        <li style="border:1px solid var(--grey-200);border-radius:12px;padding:20px 24px;font:700 19px/1.4 var(--font-sans);color:#16233d">Dakrenovatie in &#123;plaats&#125;</li>
        <li style="border:1px solid var(--grey-200);border-radius:12px;padding:20px 24px;font:700 19px/1.4 var(--font-sans);color:#16233d">Plat dak laten vervangen in &#123;regio&#125;</li>
        <li style="border:1px solid var(--grey-200);border-radius:12px;padding:20px 24px;font:700 19px/1.4 var(--font-sans);color:#16233d">Daklekkage laten repareren in &#123;plaats&#125;</li>
      </ul>
    </div>
  </section>

  <section data-screen-label="07 Rekensom" style="background:#f2f3f7;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <h2 style="margin:0 0 28px;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:24ch">Hoeveel dakoffertes liggen er op de plank?</h2>
      <Rekensom  />
    </div>
  </section>

  <section data-screen-label="08 Aanbod en garantie" style="background:#fff;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,420px),1fr));gap:20px">
      <div style="border:1px solid var(--grey-200);border-radius:12px;padding:28px">
        <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Het aanbod</p>
        <p style="margin:0;font:800 24px/1.3 var(--font-sans);color:#16233d;font-variant-numeric:tabular-nums">€ 1.950 opzet, daarna € 495 per maand.</p>
        <p style="margin:8px 0 0">12 maanden, daarna maandelijks opzegbaar. Prijzen excl. btw.</p>
        <p style="margin:12px 0 0;color:#16233d;font-variant-numeric:tabular-nums"><strong>Founding Partner:</strong> € 975 opzet en € 425 per maand, vast voor 24 maanden. <strong style="color:#c34209">Nog {FP_LEFT} van 5 plekken.</strong></p>
        <a href="/prijs/" style="display:inline-block;margin-top:16px;font-weight:700">Bekijk de prijs →</a>
      </div>
      <div style="border:1px solid var(--grey-200);border-radius:12px;padding:28px">
        <p style="margin:0 0 12px;font:700 13px/1.3 var(--font-sans);letter-spacing:.11em;text-transform:uppercase;color:#c34209">Garantie</p>
        <ol style="margin:0;padding-left:20px;display:flex;flex-direction:column;gap:8px;color:#16233d">
          <li>Live binnen 4 weken, anders vervalt de tweede termijn van de opzet.</li>
          <li>Meer aanvragen dan dezelfde periode vorig jaar, anders werk ik tot 3 maanden gratis door.</li>
          <li>Je website en je gegevens blijven van jou.</li>
        </ol>
        <a href="/garantie/" style="display:inline-block;margin-top:16px;font-weight:700">Lees de volledige garantie →</a>
      </div>
    </div>
  </section>

  <section data-screen-label="09 Regiocheck" style="background:#f2f3f7;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:1120px;margin:0 auto">
      <h2 style="margin:0 0 28px;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d;max-width:26ch">Eén dakdekker per regio. Is die van jou nog vrij?</h2>
      <RegioCheck vak="Dakdekkers" />
    </div>
  </section>

  <section data-screen-label="10 Vragen" style="background:#fff;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:800px;margin:0 auto">
      <h2 style="margin:0 0 24px;font:800 clamp(28px,4.2vw,40px)/1.12 var(--font-sans);letter-spacing:-0.02em;color:#16233d">Wat dakdekkers vragen</h2>
      <div style="border-top:1px solid var(--grey-200)">
        <details style="border-bottom:1px solid var(--grey-200)"><summary style="cursor:pointer;padding:20px 0;display:flex;justify-content:space-between;gap:16px;font-weight:700;font-size:18px;color:#16233d">Werkt dit ook voor spoedklussen?<span class="chev" aria-hidden="true" style="transition:transform 180ms">▾</span></summary><p style="margin:0 0 20px">Ja. Sam vraagt meteen of het spoed is en zet die aanvragen bovenaan in je app.</p></details>
        <details style="border-bottom:1px solid var(--grey-200)"><summary style="cursor:pointer;padding:20px 0;display:flex;justify-content:space-between;gap:16px;font-weight:700;font-size:18px;color:#16233d">Ik krijg nu klussen via een klusplatform.<span class="chev" aria-hidden="true" style="transition:transform 180ms">▾</span></summary><p style="margin:0 0 20px">Dat kun je houden zolang je wilt. Het verschil: deze aanvragen komen via je eigen site en zijn alleen van jou.</p></details>
        <details style="border-bottom:1px solid var(--grey-200)"><summary style="cursor:pointer;padding:20px 0;display:flex;justify-content:space-between;gap:16px;font-weight:700;font-size:18px;color:#16233d">Ik kan het werk nu al nauwelijks aan.<span class="chev" aria-hidden="true" style="transition:transform 180ms">▾</span></summary><p style="margin:0 0 20px">Dan helpt de bonus: een "Werken bij"-pagina waarop sollicitanten ook binnen 2 minuten een WhatsApp krijgen.</p></details>
      </div>
    </div>
  </section>

  <section data-screen-label="11 Slot" style="background:#16233d;padding:clamp(56px,8vw,96px) 20px">
    <div style="max-width:760px;margin:0 auto;text-align:center;display:flex;flex-direction:column;align-items:center">
      <h2 style="margin:0;font:800 clamp(30px,4.6vw,46px)/1.1 var(--font-sans);letter-spacing:-0.02em;color:#fff">Zie wat er bij jou blijft liggen.</h2>
      <div style="margin-top:32px"><Btn variant="primary" href="/scan/?vak=Dakdekkers" label="Vraag je gratis Aanvragen Scan aan" /></div>
      <p style="margin:16px 0 0;color:#d4d7de;font-size:15px">Je krijgt binnen 2 minuten een WhatsApp van Sam. Dat is meteen je eerste demo.</p>
    </div>
  </section>
</main>
</Base>
